{
 "_comment": "Template for study-2 latent-space IMGEP runs. Copy per (variant x seed), set parameter_map.config.variant and seed, and save_location to runs/latent/<variant>/seed<N>. sigma=0.1 means 'one mutation step = 10% of the empirical per-dim latent std' (see DexedLatentMap docstring); calibrate against study 1's mutation locality before the main runs.",
 "experiment": {
  "config": {
   "save_location": "runs/latent/avec_tout/seed0",
   "save_frequency": 1,
   "bootstrap_size": 100
  }
 },
 "system": {
  "path": "systems.Dexed.DexedSimulation",
  "config": {
   "output_Fs": 16000,
   "midi_note_duration_s": 3.0,
   "render_duration_s": 4.0,
   "midi_pitch": 56,
   "midi_velocity": 75
  }
 },
 "explorer": {
  "path": "adtool.explorers.IMGEPExplorer.IMGEPExplorer",
  "config": {
   "mutator": {
    "path": "adtool.mutators.SpecificMutator",
    "config": {}
   },
   "equil_time": 1,
   "behavior_map": {
    "path": "maps.DexedStatistics.DexedStatistics",
    "config": {}
   },
   "parameter_map": {
    "path": "maps.DexedLatentMap.DexedLatentMap",
    "config": {
     "seed": 0,
     "variant": "avec_tout",
     "sigma": 0.1,
     "sample_mode": "gaussian"
    }
   }
  }
 },
 "input_wrappers": [],
 "output_representations": [],
 "logger_handlers": [],
 "callbacks": {
  "on_discovery": [
   {
    "path": "adtool.callbacks.on_discovery_callbacks.save_discovery_on_disk.SaveDiscoveryOnDisk",
    "config": {}
   }
  ]
 }
}
